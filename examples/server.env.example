# Complete this file outside source control with owner-only permissions.
# Generate once; preserve the deployment key across restarts and backups.
CDC_ADMIN_TOKEN=REPLACE_WITH_A_RANDOM_TOKEN_OF_AT_LEAST_32_CHARACTERS
CDC_MASTER_KEY=REPLACE_WITH_BASE64_ENCODING_OF_EXACTLY_32_RANDOM_BYTES
CDC_PORT=8080

# Management repository (default SQLITE); local task journals always remain SQLite.
CDC_CONTROL_DB_TYPE=SQLITE
# CDC_CONTROL_DB_TYPE=MYSQL
# CDC_CONTROL_MYSQL_HOST=db.example
# CDC_CONTROL_MYSQL_PORT=3306
# CDC_CONTROL_MYSQL_DATABASE=cdc_ex_control
# CDC_CONTROL_MYSQL_USER=cdc_ex
# CDC_CONTROL_MYSQL_PASSWORD=replace-me
# CDC_CONTROL_MYSQL_SSL_MODE=VERIFY_IDENTITY
# CDC_CONTROL_DB_TYPE=MONGODB
# CDC_CONTROL_MONGO_URI=mongodb://user:password@mongo.example:27017/?authSource=admin
# CDC_CONTROL_MONGO_DATABASE=cdc_ex_control
# CDC_CONTROL_MONGO_TLS=true
# CDC_CONTROL_ALLOW_INSECURE=false
